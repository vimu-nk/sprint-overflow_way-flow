# WayFlow configuration. Copy to .env (`pnpm bootstrap`). Every value here is a DEV/DEMO placeholder:
# with NODE_ENV=production the API refuses to start on example secrets (specs/19 SEC-58).

NODE_ENV=development
TZ=Asia/Colombo
LOG_LEVEL=info

# --- Postgres (owner role: migrations + seed only) ---
POSTGRES_USER=wayflow
POSTGRES_PASSWORD=wayflow
POSTGRES_DB=wayflow
DATABASE_URL=postgres://wayflow:wayflow@localhost:5432/wayflow
# Least-privilege runtime role created by the migrate job (SEC-60). The API connects with APP_DATABASE_URL.
APP_DB_PASSWORD=wayflow-app-db-dev
APP_DATABASE_URL=postgres://wayflow_app:wayflow-app-db-dev@localhost:5432/wayflow

# --- Valkey (pub/sub for live notifications, login throttling) ---
VALKEY_URL=redis://localhost:6379

# --- RustFS (S3-compatible object storage) ---
# Admin (root) – console login at http://localhost:9001
RUSTFS_ADMIN_USER=rustfsadmin
RUSTFS_ADMIN_PASSWORD=rustfsadmin-change-me
# App key used by the API, limited to S3_BUCKET (created by storage-init)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wayflow-app
S3_SECRET_KEY=wayflow-app-secret
S3_BUCKET=pod

# --- API ---
API_PORT=3000
PLANNER_URL=http://localhost:8000
# Generate real values with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-change-me-0123456789ab
CSRF_SECRET=dev-only-csrf-secret-change-me-0123456789abcdef
# true whenever the app is served over HTTPS (required in production)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY_HOPS=1
# Swagger UI at /api/docs (off by default outside dev)
ENABLE_API_DOCS=true

# --- Demo ---
# Simulation clock start (Asia/Colombo). The calendar data ends 2026-06-28, so "today" is simulated.
APP_SIMULATION_DATE=2026-05-19
APP_SIMULATION_TIME=14:00
# Dispatcher-only demo tools: simulation clock and demo reset (SEC-30)
ENABLE_DEMO_TOOLS=true
# Password for every seeded account (min 12 chars). Change it for any shared deployment.
SEED_DEFAULT_PASSWORD=Waypoint-Demo-2026!
# Competition CSVs (relative to apps/api when running on the host)
DATA_DIR=../../data/source

# --- Gateway ---
WEB_PORT=8080
